_private
N
E_ouxfs_Q_directory_I_list_directory( N disc_id
, N partition_i
, N64 uid
, N *n
, N64 **list
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    E_flow_Z_lock_rw_I_lock_read( &disc->partition[ partition_i ].lock_rw );
    N r = disc->partition[ partition_i ].return_;
    K(r)
        return ~0;
    disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    if( ~uid )
    {   N64 directory_i;
        r = E_ouxfs_Q_directory_R( disc_id, partition_i, uid, &directory_i );
        if( K_error(r) )
            goto End;
    }
    Mt_( *list, 0 );
    if( K_error( *list )
    || !*list
    )
    {   r = *list ? (N)*list : ~0;
        goto End;
    }
    *n = 0;
    for_n( directory_i, disc->partition[ partition_i ].oux.directory_n )
        if( disc->partition[ partition_i ].oux.directory[ directory_i ].parent == uid )
        {   r = (N)E_mem_Q_blk_I_append( list, 1 );
            if( K_error(r)
            || !r
            )
            {   if( K_error(r) )
                {   if( r == ~4 )
                        Gk(E_mem_Q_blk_I_append( list, 1 ));
                    if( r > ~2 )
                        r = ~2;
                    goto End;
                }
                N r_ = W( *list );
                if( (S)r_ < r )
                    r = r_;
                if( K_error( r_ ))
                {   if( r > ~2 )
                        r = ~2;
                    goto End;
                }
                r = ~0;
                goto End;
            }
            r = 0;
            (*list)[ *n ] = disc->partition[ partition_i ].oux.directory[ directory_i ].uid;
            (*n)++;
        }
End:E_flow_Z_lock_rw_I_unlock_read_and_return( &disc->partition[ partition_i ].lock_rw, &disc->partition[ partition_i ].return_, r );
    return r;
}
