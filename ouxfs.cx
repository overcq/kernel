//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
_private
N
E_ouxfs_Q_watch_directory_M( I disc_id
, N partition_i
, N64 uid
, I report
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    E_flow_Z_lock_rw_I_lock_write( &disc->partition[ partition_i ].lock_rw );
    N r = disc->partition[ partition_i ].return_;
    K(r)
        return ~0;
    disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    N64 i;
    if( disc->partition[ partition_i ].oux.watch_directory_n )
    {   N64 min = 0;
        N64 max = disc->partition[ partition_i ].oux.watch_directory_n - 1;
        i = min + ( max + 1 - min ) / 2;
        O{  if( disc->partition[ partition_i ].oux.watch_directory[i].report == report )
                break;
            if( disc->partition[ partition_i ].oux.watch_directory[i].report > report )
            {   if( i == min )
                    break;
                max = i - 1;
                i = max - ( i - min ) / 2;
            }else
            {   if( i == max )
                {   do
                        i++;
                    while( i != disc->partition[ partition_i ].oux.watch_directory_n
                    && disc->partition[ partition_i ].oux.watch_directory[i].report < report
                    );
                    break;
                }
                min = i + 1;
                i = min + ( max - i ) / 2;
            }
        }
        do
            i++;
        while( i != disc->partition[ partition_i ].oux.watch_directory_n
        && disc->partition[ partition_i ].oux.watch_directory[i].report == report
        && disc->partition[ partition_i ].oux.watch_directory[i].uid != uid
        );
        if( i != disc->partition[ partition_i ].oux.watch_directory_n
        && disc->partition[ partition_i ].oux.watch_directory[i].report == report
        )
        {   r = ~0;
            goto End;
        }
    }else
        i = 0;
    r = (N)E_mem_Q_blk_I_insert( &disc->partition[ partition_i ].oux.watch_directory, i, 1 );
    if( K_error(r)
    || !r
    )
    {   if( K_error(r) )
        {   if( r == ~4 )
                Gk(E_mem_Q_blk_I_insert( &disc->partition[ partition_i ].oux.watch_directory, i, 1 ));
            goto End;
        }
        r = ~0;
        goto End;
    }
    disc->partition[ partition_i ].oux.watch_directory_n++;
    disc->partition[ partition_i ].oux.watch_directory[i].uid = uid;
    disc->partition[ partition_i ].oux.watch_directory[i].report = report;
End:E_flow_Z_lock_rw_I_unlock_write_and_return( &disc->partition[ partition_i ].lock_rw, &disc->partition[ partition_i ].return_, r );
    return r;
}
_private
N
E_ouxfs_Q_watch_directory_W( I disc_id
, N partition_i
, N64 uid
, I report
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    E_flow_Z_lock_rw_I_lock_write( &disc->partition[ partition_i ].lock_rw );
    N r = disc->partition[ partition_i ].return_;
    K(r)
        return ~0;
    disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    if( !disc->partition[ partition_i ].oux.watch_directory_n )
    {   r = ~0;
        goto End;
    }
    N64 min = 0;
    N64 max = disc->partition[ partition_i ].oux.watch_directory_n - 1;
    N64 i = min + ( max + 1 - min ) / 2;
    O{  if( disc->partition[ partition_i ].oux.watch_directory[i].report == report )
            break;
        if( disc->partition[ partition_i ].oux.watch_directory[i].report > report )
        {   if( i == min )
            {   r = ~0;
                goto End;
            }
            max = i - 1;
            i = max - ( i - min ) / 2;
        }else
        {   if( i == max )
            {   r = ~0;
                goto End;
            }
            min = i + 1;
            i = min + ( max - i ) / 2;
        }
    }
    if( disc->partition[ partition_i ].oux.watch_directory[i].uid != uid )
    {   do
            i++;
        while( i != disc->partition[ partition_i ].oux.watch_directory_n
        && disc->partition[ partition_i ].oux.watch_directory[i].report == report
        && disc->partition[ partition_i ].oux.watch_directory[i].uid != uid
        );
        if( i == disc->partition[ partition_i ].oux.watch_directory_n
        || disc->partition[ partition_i ].oux.watch_directory[i].report != report
        )
        {   r = ~0;
            goto End;
        }
    }
    r = (N)E_mem_Q_blk_I_remove( &disc->partition[ partition_i ].oux.watch_directory, i, 1 );
    if( K_error(r)
    || !r
    )
    {   if( K_error(r) )
        {   if( r == ~4 )
                Gk(E_mem_Q_blk_I_remove( &disc->partition[ partition_i ].oux.watch_directory, i, 1 ));
            goto End;
        }
        r = ~0;
        goto End;
    }
    disc->partition[ partition_i ].oux.watch_directory_n--;
End:E_flow_Z_lock_rw_I_unlock_write_and_return( &disc->partition[ partition_i ].lock_rw, &disc->partition[ partition_i ].return_, r );
    return r;
}
_private
N
E_ouxfs_Q_watch_directory_W_report( I disc_id
, N partition_i
, I report
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    E_flow_Z_lock_rw_I_lock_write( &disc->partition[ partition_i ].lock_rw );
    N r = disc->partition[ partition_i ].return_;
    K(r)
        return ~0;
    disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    if( !disc->partition[ partition_i ].oux.watch_directory_n )
    {   r = ~0;
        goto End;
    }
    N64 min = 0;
    N64 max = disc->partition[ partition_i ].oux.watch_directory_n - 1;
    N64 i = min + ( max + 1 - min ) / 2;
    O{  if( disc->partition[ partition_i ].oux.watch_directory[i].report == report )
            break;
        if( disc->partition[ partition_i ].oux.watch_directory[i].report > report )
        {   if( i == min )
            {   r = ~0;
                goto End;
            }
            max = i - 1;
            i = max - ( i - min ) / 2;
        }else
        {   if( i == max )
            {   r = ~0;
                goto End;
            }
            min = i + 1;
            i = min + ( max - i ) / 2;
        }
    }
    N end = i;
    do
        end++;
    while( end != disc->partition[ partition_i ].oux.watch_directory_n
    && disc->partition[ partition_i ].oux.watch_directory[end].report == report
    );
    r = (N)E_mem_Q_blk_I_remove( &disc->partition[ partition_i ].oux.watch_directory, i, end - i );
    if( K_error(r)
    || !r
    )
    {   if( K_error(r) )
        {   if( r == ~4 )
                Gk(E_mem_Q_blk_I_remove( &disc->partition[ partition_i ].oux.watch_directory, i, end - i ));
            goto End;
        }
        r = ~0;
        goto End;
    }
    disc->partition[ partition_i ].oux.watch_directory_n--;
End:E_flow_Z_lock_rw_I_unlock_write_and_return( &disc->partition[ partition_i ].lock_rw, &disc->partition[ partition_i ].return_, r );
    return r;
}
