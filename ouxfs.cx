}
//------------------------------------------------------------------------------
#undef E_ouxfs_Q_device_I_switch_item
#define E_ouxfs_Q_device_I_switch_item( type, item, end ) \
    if( data_i ) \
    {   do \
        {   *data++ = ( item >> ( data_i++ * 8 )) & 0xff; \
        }while( data_i != sizeof(type) \
        && data != (end) \
        ); \
        if( data_i == sizeof(type) ) \
            data_i = 0; \
        else \
            break; \
    }else \
    {   if( data == (end) ) \
            break; \
        if( data + sizeof(type) > (end) ) \
        {   do \
            {   *data++ = ( item >> ( data_i++ * 8 )) & 0xff; \
            }while( data != (end) ); \
            break; \
        } \
        *( type * )data = item; \
        data += sizeof(type); \
    } \
    continue_from++
