    }
    r = E_ouxfs_Q_file_I_read_( disc_id, partition_i, file_i, pos, n, data );
End:E_flow_Z_lock_rw_I_unlock_read_and_return( &disc->partition[ partition_i ].lock_rw, &disc->partition[ partition_i ].return_, r );
    return r;
}
