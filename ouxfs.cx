        }
    found = no;
    directory_i = 0;
    do
    {   for( ; directory_i != disc->partition[ partition_i ].oux.directory_n; directory_i++ )
            if( disc->partition[ partition_i ].oux.directory[ directory_i ].parent == uid_src )
            {   found = yes;
                uid_src = disc->partition[ partition_i ].oux.directory[ directory_i ].uid;
