_private
N
E_ouxfs_Q_directory_I_copy( N disc_id
, N partition_i
, N64 *uid
, N64 parent
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    E_flow_Z_lock_rw_I_lock_write( &disc->partition[ partition_i ].lock_rw );
    N r = disc->partition[ partition_i ].return_;
    K(r)
        return ~0;
    disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    N64 uid_src_root = *uid;
    N64 directory_i;
    r = E_ouxfs_Q_directory_R( disc_id, partition_i, uid_src_root, &directory_i );
    if( K_error(r) )
        goto End;
    if( ~parent )
    {   N64 directory_i;
        r = E_ouxfs_Q_directory_R( disc_id, partition_i, parent, &directory_i );
        if( K_error(r) )
            goto End;
        if( uid_src_root == parent )
        {   r = ~0;
            goto End;
        }
        r = E_ouxfs_Q_directory_T_descendant_( disc_id , partition_i, uid_src_root, parent );
        if( K_error(r)
        || r
        )
        {   if( !K_error(r) )
                r = ~0;
            goto End;
        }
    }
    N l = E_text_Z_s0_R_l_0( disc->partition[ partition_i ].oux.directory[ directory_i ].name );
    Pc name = M( l + J_s0_R_l( " №" ) + 2 );
    if( K_error(name)
    || !name
    )
    {   if( K_error(name) )
        {   r = (N)name;
            goto End;
        }
        r = ~0;
        goto End;
    }
    E_text_Z_s_P_copy_s0_0( name, disc->partition[ partition_i ].oux.directory[ directory_i ].name );
    N num = ~0;
    N l_num;
    B found;
    O{  found = no;
        for_n( directory_i_, disc->partition[ partition_i ].oux.directory_n )
            if( disc->partition[ partition_i ].oux.directory[ directory_i_ ].parent == parent
            && E_text_Z_s0_T_eq_s0( disc->partition[ partition_i ].oux.directory[ directory_i_ ].name, name )
            )
            {   found = yes;
                break;
            }
        if( !found )
        {   for_n( file_i, disc->partition[ partition_i ].oux.file_n )
                if( disc->partition[ partition_i ].oux.file[ file_i ].parent == parent
                && E_text_Z_s0_T_eq_s0( disc->partition[ partition_i ].oux.file[ file_i ].name, name )
                )
                {   found = yes;
                    break;
                }
        }
        if( !found )
            break;
        if( ++num == 100 )
        {   r = ~0;
            goto End;
        }
        if( !num )
        {   E_text_Z_s_P_copy_s0( &name[ l - 1 ], " №" );
            l += J_s0_R_l( " №" );
        }
        l_num = E_text_Z_n_N_s_G( num, 10 );
        name[ l - 1 + l_num ] = '\0';
        E_text_Z_n_N_s( &name[ l - 1 + l_num ], num, 10 );
    }
    if( ~num )
    {   l += l_num;
        r = (N)E_mem_Q_blk_I_remove( &name, l, 2 - l_num );
    }else
        r = (N)E_mem_Q_blk_I_remove( &name, l, J_s0_R_l( " №" ) + 2 );
    if( K_error(r)
    || !r
    )
    {   if( K_error(r) )
            goto End;
        r = ~0;
        N r_ = W(name);
        if( (S)r_ < r )
            r = r_;
        goto End;
    }
    r = E_ouxfs_Q_directory_file_I_block_append( disc_id, partition_i, 2 * sizeof( N64 ) + l
    , &disc->partition[ partition_i ].oux.block_table_directory_table_start
    , &disc->partition[ partition_i ].oux.block_table_directory_table_n
    , &disc->partition[ partition_i ].oux.directory_table_changed_from
    );
    if( K_error(r) )
    {   if( ~r )
            goto End;
        N r_ = W(name);
        if( (S)r_ < r )
            r = r_;
        goto End;
    }
    N64 uid_dst_parent = disc->partition[ partition_i ].oux.directory[ disc->partition[ partition_i ].oux.directory_n - 1 ].uid + 1;
    if( ~uid_dst_parent )
        directory_i = disc->partition[ partition_i ].oux.directory_n;
    else
    {   uid_dst_parent = 0;
        for_n_( directory_i, disc->partition[ partition_i ].oux.directory_n )
        {   if( uid_dst_parent != disc->partition[ partition_i ].oux.directory[ directory_i ].uid )
                break;
            uid_dst_parent++;
        }
        //DFN Nie potrzeba sprawdzać, czy zabrakło przestrzeni ‘uidów’, ponieważ wcześniej zabraknie miejsca w pamięci operacyjnej.
    }
    r = (N)E_mem_Q_blk_I_insert( &disc->partition[ partition_i ].oux.directory, directory_i, 1 );
    if( K_error(r)
    || !r
    )
    {   if( K_error(r) )
        {   if( r == ~4 )
                Gk(E_mem_Q_blk_I_insert( &disc->partition[ partition_i ].oux.directory, directory_i, 1 ));
            if( r > ~2 )
                r = ~2;
            goto End;
        }
        r = ~2;
        N r_ = W(name);
        if( (S)r_ < r )
            r = r_;
        goto End;
    }
    disc->partition[ partition_i ].oux.directory_n++;
    disc->partition[ partition_i ].oux.directory[ directory_i ].uid = uid_dst_parent;
    disc->partition[ partition_i ].oux.directory[ directory_i ].parent = parent;
    disc->partition[ partition_i ].oux.directory[ directory_i ].name = name;
    if( disc->partition[ partition_i ].oux.directory_table_changed_from > directory_i )
        disc->partition[ partition_i ].oux.directory_table_changed_from = directory_i;
    N64 uid_src = uid_src_root;
    for_n( file_i, disc->partition[ partition_i ].oux.file_n )
        if( disc->partition[ partition_i ].oux.file[ file_i ].parent == uid_src )
        {   N64 uid_prev = disc->partition[ partition_i ].oux.file[ file_i ].uid;
            N64 uid = uid_prev;
            r = E_ouxfs_Q_file_I_copy_( disc_id, partition_i, &uid, uid_dst_parent, file_i, 0, 0 );
            if( K_error(r) )
                goto End;
            if( uid < uid_prev )
