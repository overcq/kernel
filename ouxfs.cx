_internal
N
E_ouxfs_Q_directory_T_descendant_( N disc_id
, N partition_i
, N64 uid
, N64 uid_descendant
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    do
    {   N64 directory_i;
        K( E_ouxfs_Q_directory_R( disc_id, partition_i, uid_descendant, &directory_i ))
            return ~0;
        uid_descendant = disc->partition[ partition_i ].oux.directory[ directory_i ].parent;
    }while( ~uid_descendant
    && uid_descendant != uid
    );
    return uid_descendant == uid;
}
_internal
N
E_ouxfs_Q_watch_directory_I_check_and_signal( N disc_id
, N partition_i
, N64 uid
){  struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    if( !disc->partition[ partition_i ].oux.watch_directory_n )
        return 0;
    N i = 0;
    do
    {   N report = disc->partition[ partition_i ].oux.watch_directory[i].report;
        if( !~disc->partition[ partition_i ].oux.watch_directory[i].uid )
            E_flow_Q_report_I_signal(report);
        else
            if( disc->partition[ partition_i ].oux.watch_directory[i].uid == uid )
                E_flow_Q_report_I_signal(report);
            else
            {   N r = E_ouxfs_Q_directory_T_descendant_( disc_id, partition_i, disc->partition[ partition_i ].oux.watch_directory[i].uid, uid );
                K(r)
                    return ~0;
                if(r)
                    E_flow_Q_report_I_signal(report);
            }
        do
            i++;
        while( i != disc->partition[ partition_i ].oux.watch_directory_n
        && disc->partition[ partition_i ].oux.watch_directory[i].report == report
        );
    }while( i != disc->partition[ partition_i ].oux.watch_directory_n );
    return 0;
}
_internal
N
E_ouxfs_Q_file_I_read_( I disc_id
, N partition_i
, N64 file_i
, N64 pos
, N64 *n
, Pc data
){  N r = 0;
    struct E_disc_Z *disc = E_mem_Q_tab_R( E_disc_S, disc_id );
    Pc sector;
    N64 data_p = 0;
    for_n( block_table_i, disc->partition[ partition_i ].oux.file[ file_i ].block_table.n )
    {   struct E_ouxfs_Z_block *block = disc->partition[ partition_i ].oux.block_table + disc->partition[ partition_i ].oux.file[ file_i ].block_table.start + block_table_i;
        if( block->location_type == E_ouxfs_Z_block_Z_location_S_sectors )
        {   if( pos < block->location.sectors.pre )
            {   K( E_disc_R( disc_id, partition_i, block->sector - 1, 1, &sector ))
                    return ~0;
                disc = E_mem_Q_tab_R( E_disc_S, disc_id );
                N64 n_ = J_min( *n, block->location.sectors.pre - pos );
                E_mem_Q_blk_I_copy( data + data_p, sector + ( disc->sata_ahci.physical_sector_size - block->location.sectors.pre ) + pos, n_ );
                E_flow_Z_lock_I_unlock_and_return( &disc->sata_ahci.ssd_cache_lock, &disc->sata_ahci.sata_return, r );
                data_p += n_;
                *n -= n_;
                pos = 0;
                if( !*n )
                    break;
            }else
                pos -= block->location.sectors.pre;
            N sector_i = J_min( pos / disc->sata_ahci.physical_sector_size, block->location.sectors.n );
            pos -= sector_i * disc->sata_ahci.physical_sector_size;
            if( sector_i != block->location.sectors.n )
            {   N sectors = J_min( E_simple_Z_n_I_align_up_to_v2( *n + pos, disc->sata_ahci.physical_sector_size )
                , ( block->location.sectors.n - sector_i ) * disc->sata_ahci.physical_sector_size
                ) / disc->sata_ahci.physical_sector_size;
                K( E_disc_R( disc_id, partition_i, block->sector + sector_i, sectors, &sector ))
                    return ~0;
                disc = E_mem_Q_tab_R( E_disc_S, disc_id );
                N64 n_ = J_min( *n, ( block->location.sectors.n - sector_i ) * disc->sata_ahci.physical_sector_size - pos );
                E_mem_Q_blk_I_copy( data + data_p, sector + pos, n_ );
                E_flow_Z_lock_I_unlock_and_return( &disc->sata_ahci.ssd_cache_lock, &disc->sata_ahci.sata_return, r );
                data_p += n_;
                *n -= n_;
                pos = 0;
                if( !*n )
                    break;
            }
            if( pos < block->location.sectors.post )
            {   K( E_disc_R( disc_id, partition_i, block->sector + block->location.sectors.n, 1, &sector ))
                    return ~0;
                disc = E_mem_Q_tab_R( E_disc_S, disc_id );
                N64 n_ = J_min( *n, block->location.sectors.post - pos );
                E_mem_Q_blk_I_copy( data + data_p, sector + pos, n_ );
                E_flow_Z_lock_I_unlock_and_return( &disc->sata_ahci.ssd_cache_lock, &disc->sata_ahci.sata_return, r );
                data_p += n_;
                *n -= n_;
                pos = 0;
                if( !*n )
                    break;
            }else
                pos -= block->location.sectors.post;
        }else
            if( pos < block->location.in_sector.size )
            {   K( E_disc_R( disc_id, partition_i, block->sector, 1, &sector ))
                    return ~0;
                disc = E_mem_Q_tab_R( E_disc_S, disc_id );
                N64 n_ = J_min( *n, block->location.in_sector.size - pos );
                E_mem_Q_blk_I_copy( data + data_p, sector + block->location.in_sector.start + pos, n_ );
                E_flow_Z_lock_I_unlock_and_return( &disc->sata_ahci.ssd_cache_lock, &disc->sata_ahci.sata_return, r );
                data_p += n_;
                *n -= n_;
                pos = 0;
                if( !*n )
                    break;
            }else
                pos -= block->location.in_sector.size;
    }
    if(pos)
