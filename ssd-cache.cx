                    || !disc->sata_ahci.ssd_cache[ cache_i ].data
                    )
                    {   r = (N)E_mem_Q_blk_I_remove( &disc->sata_ahci.ssd_cache, cache_i, 1 );
                        if( K_error(r)
                        || !r
                        )
