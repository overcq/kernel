_private
N
E_ssd_cache_I_init( struct E_disc_Z *disc
){  disc->sata_ahci.ssd_cache_n = 0;
    Mt_( disc->sata_ahci.ssd_cache, disc->sata_ahci.ssd_cache_n );
    Kp( disc->sata_ahci.ssd_cache )
        return ~0;
    disc->sata_ahci.dirty_n = 0;
    Mt_( disc->sata_ahci.dirty, disc->sata_ahci.dirty_n );
    Kp( disc->sata_ahci.dirty )
    {   K_( ~1, W( disc->sata_ahci.ssd_cache ));
        return ~0;
    }
    disc->sata_ahci.trim_list_n = 0;
    Mt_( disc->sata_ahci.trim_list, disc->sata_ahci.data_set_management_count );
    Kp( disc->sata_ahci.trim_list )
    {   K_( ~1, W( disc->sata_ahci.dirty ));
        K_( ~1, W( disc->sata_ahci.ssd_cache ));
        return ~0;
    }
    _0t_( disc->sata_ahci.trim_list, disc->sata_ahci.data_set_management_count );
    return 0;
}
